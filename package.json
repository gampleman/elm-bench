{
  "private": true,
  "dependencies": {
    "elm": "0.19.1-6",
    "elm-format": "^0.8.7",
    "elm-review": "^2.13.5",
    "elm-test-rs": "^3.2.0-0",
    "npm-run-all": "^4.1.5"
  },
  "scripts": {
    "test": "npm-run-all --print-name --sequential test:make test:format test:review test:cli",
    "test:make": "elm make --docs=docs.json",
    "test:format": "elm-format src/ review/ --validate",
    "test:review": "elm-review",
    "test:cli": "cd cli && npm test",
    "fix": "npm-run-all --print-name --sequential fix:format fix:review",
    "fix:format": "elm-format src/ review/ --yes",
    "fix:review": "elm-review --fix",
    "elm-bump": "npm-run-all --print-name --sequential test bump-version 'test:review -- --fix-all-without-prompt'",
    "bump-version": "(yes | elm bump) && cd cli && npm version $(node -p \"require('../elm.json').version\") --no-git-tag-version"
  }
}
